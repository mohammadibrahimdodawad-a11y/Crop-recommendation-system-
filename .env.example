# Global Smart Crop Recommendation System - Environment Configuration
# Copy this file to .env and fill in secure values for your environment.
# NEVER commit your actual .env file or secrets to GitHub.

# Application URL
APP_URL="http://localhost:3000"

# Session & Cookie Security (generate a random 64-character hex string in production)
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_HEX_SECRET"

# Database Configuration
# Initial development uses SQLite; configure DATABASE_URL when migrating to PostgreSQL
DATABASE_PATH="./data/agronomy.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/global_smart_crop"

# External Agricultural & Weather APIs (Public / Open-Access Endpoints)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
SOILGRIDS_BASE_URL="https://rest.isric.org/soilgrids/v2.0"

# Environment Mode
NODE_ENV="development"
PORT=3000
